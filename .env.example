# Only values that have NO default in code live here.
# Everything already defaulted in code is documented in the README as an
# override, not listed here. We never read a .env file ourselves; the host
# (Railway, local shell) puts these into the environment.

# Public BNB address holding the worm's creator-fee treasury (READ ONLY).
TREASURY_ADDRESS=

# Token contract address. The buy link is built from this automatically
# (flap.sh/bnb/<CONTRACT_ADDRESS>), so there is no separate buy URL to set.
CONTRACT_ADDRESS=

# DeepSeek API key. If omitted, the diary runs in dormant mode using fallback
# lines. The money and simulation loop still run without it.
DEEPSEEK_API_KEY=
